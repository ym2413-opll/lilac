#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

// Application Icon
IDI_APPICON ICON "icon.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "열기(&O)...\tCtrl+O",             IDM_FILE_OPEN
        POPUP "최근 파일(&R)"
        BEGIN
            MENUITEM "(최근 파일 없음)",             IDM_RECENT_EMPTY, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "PDF 내보내기(&P)...\tCtrl+P",     IDM_FILE_EXPORT_PDF
        MENUITEM "DOCX 내보내기(&D)...\tCtrl+D",    IDM_FILE_EXPORT_DOCX
        MENUITEM SEPARATOR
        MENUITEM ".md 기본 프로그램 등록(&R)",      IDM_FILE_REGISTER
        MENUITEM ".md 연결 해제(&U)",               IDM_FILE_UNREGISTER
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)\tAlt+F4",               IDM_FILE_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "복사(&C)\tCtrl+C",                 IDM_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)\tCtrl+A",            IDM_EDIT_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "찾기(&F)...\tCtrl+F",             IDM_EDIT_FIND
        MENUITEM "다음 찾기(&N)\tF3",                IDM_EDIT_FIND_NEXT
        MENUITEM "이전 찾기(&P)\tShift+F3",          IDM_EDIT_FIND_PREV
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\tCtrl++",                 IDM_VIEW_ZOOMIN
        MENUITEM "축소(&O)\tCtrl+-",                 IDM_VIEW_ZOOMOUT
        MENUITEM "원래 크기(&0)\tCtrl+0",            IDM_VIEW_ZOOMRESET
        MENUITEM SEPARATOR
        MENUITEM "어둡게(&D)\tCtrl+T",               IDM_VIEW_DARKMODE
        MENUITEM SEPARATOR
        MENUITEM "목차 표시(&M)\tCtrl+M",            IDM_VIEW_TOC
        POPUP "목차 위치(&L)"
        BEGIN
            MENUITEM "왼쪽(&L)",                      IDM_VIEW_TOC_LEFT
            MENUITEM "오른쪽(&R)",                    IDM_VIEW_TOC_RIGHT
        END
        MENUITEM SEPARATOR
        MENUITEM "새로 고침(&R)\tF5",                IDM_VIEW_REFRESH
    END
    MENUITEM "나누어 보기(&N)",                      IDM_VIEW_SPLIT_VERT
    POPUP "설정(&S)"
    BEGIN
        MENUITEM "글꼴 설정(&F)...",                 IDM_SETTINGS_FONT
        MENUITEM SEPARATOR
        MENUITEM "본문 글꼴 변경...",                IDM_SETTINGS_BODY_FONT
        MENUITEM "고정폭 글꼴 변경...",              IDM_SETTINGS_MONO_FONT
        MENUITEM SEPARATOR
        MENUITEM "글꼴 초기화(&R)",                  IDM_SETTINGS_RESET_FONT
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "정보(&A)...",                      IDM_HELP_ABOUT
    END
END

IDD_FONT_DIALOG DIALOGEX 0, 0, 320, 190
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "글꼴 설정"
FONT 9, "맑은 고딕"
BEGIN
    GROUPBOX        "본문 글꼴 체인 (일반 텍스트, 제목, 표)", -1, 10, 10, 300, 68
    LTEXT           "글꼴 목록 (쉼표로 구분):", -1, 18, 24, 210, 10
    EDITTEXT        IDC_EDIT_BODY_CHAIN, 18, 38, 220, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "추가(&B)...", IDC_BTN_CHANGE_BODY, 243, 37, 60, 16
    LTEXT           "- 앞 글꼴부터 우선 적용되며, 빠진 글자는 다음 글꼴로 보완됩니다.", -1, 18, 56, 285, 16

    GROUPBOX        "고정폭 글꼴 체인 (코드 블록, 인라인 코드)", -1, 10, 84, 300, 68
    LTEXT           "글꼴 목록 (쉼표로 구분):", -1, 18, 98, 210, 10
    EDITTEXT        IDC_EDIT_MONO_CHAIN, 18, 112, 220, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "추가(&M)...", IDC_BTN_CHANGE_MONO, 243, 111, 60, 16
    LTEXT           "- 이모지와 기호는 기본 대체 체인으로 자동 보완됩니다.", -1, 18, 130, 285, 16

    PUSHBUTTON      "초기화(&R)", IDC_BTN_RESET, 10, 162, 70, 18
    DEFPUSHBUTTON   "확인", IDOK, 205, 162, 50, 18
    PUSHBUTTON      "취소", IDCANCEL, 260, 162, 50, 18
END

IDR_ACCEL ACCELERATORS
BEGIN
    "O",            IDM_FILE_OPEN,          VIRTKEY, CONTROL
    "P",            IDM_FILE_EXPORT_PDF,    VIRTKEY, CONTROL
    "D",            IDM_FILE_EXPORT_DOCX,   VIRTKEY, CONTROL
    "S",            IDM_FILE_EXPORT_DOCX,   VIRTKEY, CONTROL
    "F",            IDM_EDIT_FIND,          VIRTKEY, CONTROL
    "C",            IDM_EDIT_COPY,          VIRTKEY, CONTROL
    "A",            IDM_EDIT_SELECT_ALL,    VIRTKEY, CONTROL
    VK_F3,          IDM_EDIT_FIND_NEXT,     VIRTKEY
    VK_F3,          IDM_EDIT_FIND_PREV,     VIRTKEY, SHIFT
    VK_OEM_PLUS,    IDM_VIEW_ZOOMIN,        VIRTKEY, CONTROL
    VK_ADD,         IDM_VIEW_ZOOMIN,        VIRTKEY, CONTROL
    VK_OEM_MINUS,   IDM_VIEW_ZOOMOUT,       VIRTKEY, CONTROL
    VK_SUBTRACT,    IDM_VIEW_ZOOMOUT,       VIRTKEY, CONTROL
    "0",            IDM_VIEW_ZOOMRESET,     VIRTKEY, CONTROL
    "T",            IDM_VIEW_DARKMODE,      VIRTKEY, CONTROL
    "M",            IDM_VIEW_TOC,           VIRTKEY, CONTROL
    VK_OEM_5,       IDM_VIEW_SPLIT_VERT,    VIRTKEY, CONTROL
    "W",            IDM_VIEW_SPLIT_CLOSE,   VIRTKEY, CONTROL
    VK_F5,          IDM_VIEW_REFRESH,       VIRTKEY
END

1 24 "manifest.xml"
